rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper to check if user is logged in as an authenticated Administrator in the admins collection
    function isAdmin() {
      return request.auth != null && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email))
      );
    }

    // --- ADMINS COLLECTION ---
    match /admins/{userId} {
      // Allow user to get their own admin record or query their own record by email during login
      allow get: if request.auth != null && (
        request.auth.uid == userId || 
        request.auth.token.email == userId
      );
      allow list: if request.auth != null && (
        resource.data.email == request.auth.token.email
      );
      // Bootstrapping: Allow the designated super_admin email to create their own admin document
      allow create: if request.auth != null && (
        request.auth.token.email == '236102601@uii.ac.id' && (userId == request.auth.uid || userId == request.auth.token.email)
      );
      // Existing verified admins have full read/write access
      allow read, write: if isAdmin();
    }

    // --- MAHASISWA COLLECTION ---
    match /mahasiswa/{mhsId} {
      // Admins have full read and write capabilities
      allow write: if isAdmin();
      // Public can read single or query list of students (for verification)
      allow read: if true;
    }
    
    // --- JADWAL COLLECTION ---
    match /jadwal/{jadwalId} {
      // Admins have full write capabilities
      allow write: if isAdmin();
      // Public can read single or list of schedules
      allow read: if true;
      
      // Public can increment or decrement booked_count (cannot alter other fields)
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['booked_count'])
                    && (request.resource.data.booked_count == resource.data.booked_count + 1 
                        || request.resource.data.booked_count == resource.data.booked_count - 1);
    }
    
    // --- BOOKING COLLECTION ---
    match /booking/{bookingId} {
      // Admins have full write capabilities
      allow write: if isAdmin();
      // Public can read or list bookings to check reservation status
      allow read: if true;
      
      // Helper to check if booking portal is currently active in global settings
      function isBookingActive() {
        return get(/databases/$(database)/documents/settings/global).data.booking_active == true;
      }

      // Public can create new bookings only when portal is open
      allow create: if isBookingActive()
                    && request.resource.data.status == 'Belum Diambil' 
                    && request.resource.data.keys().hasAll(['booking_id', 'mahasiswa_id', 'jadwal_id', 'tanggal', 'jam', 'wa', 'status', 'qr_token', 'created_at', 'updated_at']);

                    
      // Public can change ticket status to "Hangus" to flag expired bookings OR reschedule their schedule (with WA update)
      allow update: if (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updated_at'])
                        && request.resource.data.status == 'Hangus')
                    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['jadwal_id', 'tanggal', 'jam', 'wa', 'updated_at'])
                        && resource.data.status == 'Belum Diambil');
    }
    
    // --- DISTRIBUSI (ACTIVITY LOGS) COLLECTION ---
    match /distribusi/{distribusiId} {
      // Only Admins can read or write logs of actual KTM hand-overs
      allow read, write: if isAdmin();
    }
    
    // --- ACTIVITY LOGS COLLECTION ---
    match /activity/{activityId} {
      // Only Admins can read or write system activities
      allow read, write: if isAdmin();
    }
    
    // --- LIVE_SCANS (PUBLIC SCAN QUEUE) COLLECTION ---
    match /live_scans/{scanId} {
      // Admins have full access to view, update, and clear the queue
      allow read, write: if isAdmin();
      
      // Public scanner can write a new scan entry to the queue for admin real-time terminal display
      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.keys().hasAll(['booking_id', 'mahasiswa_id', 'nim', 'nama', 'prodi', 'scanned_at', 'status', 'is_early']);
    }

    // --- PRODI_MAPPING COLLECTION ---
    match /prodi_mapping/{mappingId} {
      // Admins can write
      allow write: if isAdmin();
      // Public can read to verify location
      allow read: if true;
    }

    // --- SETTINGS COLLECTION ---
    match /settings/{settingsId} {
      // Public can read settings
      allow read: if true;
      // Admins can write settings
      allow write: if isAdmin();
    }
  }
}
